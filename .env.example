# Copy to .env (local) or paste into your host's environment variables. Never commit the real file.
# Aiven "Service URI" (keep ?ssl-mode=REQUIRED at the end)
DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@YOUR_HOST.aivencloud.com:22495/defaultdb?ssl-mode=REQUIRED
# Optional but recommended: contents of Aiven's CA certificate (ca.pem). Newlines can be written as \n
# DATABASE_CA_CERT=
AGENT_ADMIN_USERNAME=choose-a-username
AGENT_ADMIN_PASSWORD=choose-a-long-unique-password
# REQUIRED for admin login: any long random string (32+ characters). Signs the login cookie.
MANUS_JWT_SECRET=paste-a-long-random-string-here
PORT=3000
